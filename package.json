{
  "name": "@canac/oxc-config",
  "version": "0.1.0",
  "description": "Shared oxlint and oxfmt config",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/canac/oxc-config.git"
  },
  "files": [
    "oxlint.js",
    "oxfmt.js",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./oxlint": {
      "types": "./dist/oxlint.d.ts",
      "default": "./oxlint.js"
    },
    "./oxfmt": {
      "types": "./dist/oxfmt.d.ts",
      "default": "./oxfmt.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.2004",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "oxfmt": ">=0.72.0 <1.0.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    },
    "oxlint-tsgolint": {
      "optional": true
    }
  },
  "packageManager": "pnpm@12.11.2"
}
